rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    match /svh_accounts/{usernameLower} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['userId', 'usernameLower', 'displayName', 'role', 'createdAt'])
        && isValidString(request.resource.data.userId, 128)
        && isValidString(request.resource.data.usernameLower, 80)
        && isValidString(request.resource.data.displayName, 120);
      allow delete: if true;
    }

    match /svh_users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['userId', 'displayName'])
        && isValidString(request.resource.data.userId, 128)
        && isValidString(request.resource.data.displayName, 120);
      allow delete: if true;
    }

    match /svh_vp_transactions/{txId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'userId', 'timestamp', 'amount', 'reason'])
        && isValidString(request.resource.data.id, 180)
        && isValidString(request.resource.data.userId, 128)
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 500;
      allow delete: if true;
    }

    match /svh_deletion_events/{eventId} {
      allow read, write: if true;
    }

    match /svh_posts/{postId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'authorId', 'authorName', 'subject', 'createdAt'])
        && isValidString(request.resource.data.id, 128)
        && isValidString(request.resource.data.authorId, 128)
        && isValidString(request.resource.data.authorName, 120);
      allow delete: if true;
    }

    match /svh_replies/{replyId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'postId', 'authorId', 'authorName', 'createdAt'])
        && isValidString(request.resource.data.id, 128)
        && isValidString(request.resource.data.postId, 128)
        && isValidString(request.resource.data.authorId, 128);
      allow delete: if true;
    }

    match /svh_chat/{msgId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'authorId', 'authorName', 'content', 'createdAt'])
        && isValidString(request.resource.data.id, 128)
        && isValidString(request.resource.data.authorId, 128)
        && isValidString(request.resource.data.content, 5000);
      allow delete: if true;
    }

    match /svh_reports/{reportId} {
      allow read, write: if true;
    }

    match /svh_ai_conversations/{docId} {
      allow read, write: if true;
    }
  }
}
